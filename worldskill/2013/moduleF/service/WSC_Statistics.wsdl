<?xml version ='1.0' encoding ='UTF-8' ?>
<definitions name='WSCstats'
  targetNamespace='http://www.mytest.com/WSCstats'
  xmlns:tns='http://www.mytest.com/WSCstats'
  xmlns:soap='http://schemas.xmlsoap.org/wsdl/soap/'
  xmlns:xsd='http://www.w3.org/2001/XMLSchema'
  xmlns:soapenc='http://schemas.xmlsoap.org/soap/encoding/'
  xmlns:wsdl='http://schemas.xmlsoap.org/wsdl/'
  xmlns='http://schemas.xmlsoap.org/wsdl/'> 

<types>
  <xsd:schema targetNamespace='http://www.mytest.com/WSCstats' attributeFormDefault='unqualified' elementFormDefault='qualified'>
	<xsd:element name="list">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name='countrys' minOccurs='0' maxOccurs='1'>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name='country' minOccurs='1' maxOccurs='unbounded'>
								<xsd:complexType>
									<xsd:simpleContent>
										<xsd:extension base='xsd:string'>
											<xsd:attribute name='iso' type='xsd:string'/>
										</xsd:extension>
									</xsd:simpleContent>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name='skills' type='tns:skills' minOccurs='0' maxOccurs='1'/>
				<xsd:element name='results' type='tns:results' minOccurs='0' maxOccurs='1'/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:complexType name='skills'>
		<xsd:sequence>
			<xsd:element name='skill' type='tns:skill' minOccurs='1' maxOccurs='unbounded'/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name='skill'>
		<xsd:sequence>
			<xsd:element name='name_en' type='xsd:string' minOccurs='1' maxOccurs='1'/>
		</xsd:sequence>
		<xsd:attribute name='number' type='xsd:string' minOccurs='1' maxOccurs='1'/>
	</xsd:complexType>
	<xsd:complexType name='results'>
		<xsd:sequence>
			<xsd:element name='result' type='tns:result' minOccurs='1' maxOccurs='unbounded'/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name='result'>
		<xsd:sequence>
			<xsd:element name='year' type='xsd:int' minOccurs='1' maxOccurs='1'/>
			<xsd:element name='skill_number' type='xsd:string' minOccurs='1' maxOccurs='1'/>
			<xsd:element name='country_iso' type='xsd:string' minOccurs='1' maxOccurs='1'/>
			<xsd:element name='score' type='tns:score' minOccurs='1' maxOccurs='1'/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name='score'>
		<xsd:sequence>
			<xsd:element name='award' type='xsd:string' minOccurs='0' maxOccurs='1'/>
			<xsd:element name='points' type='xsd:int' minOccurs='1' maxOccurs='1'/>
		</xsd:sequence>
	</xsd:complexType>
  </xsd:schema>
</types>

<message name='getListRequest'>
  <part name='listType' type='xsd:string'/>
</message>
<message name='getListResponse'>
  <part name='list' element='tns:list'/>
</message> 
<message name='getResultsRequest'>
</message>
<message name='getResultsResponse'>
  <part name='list' element='tns:list'/>
</message>

<portType name='WSCstatsPort'>
  <operation name='getList'>
    <input message='tns:getListRequest'/>
    <output message='tns:getListResponse'/>
  </operation>
  <operation name='getResults'>
    <input message='tns:getResultsRequest'/>
    <output message='tns:getResultsResponse'/>
  </operation>
</portType> 

<binding name='WSCstatsBinding' type='tns:WSCstatsPort'>
  <soap:binding style='rpc'
    transport='http://schemas.xmlsoap.org/soap/http'/>
  <operation name='getList'>
    <soap:operation soapAction='urn:WSCstats#getList'/>
    <input>
      <soap:body use='encoded' namespace='urn:WSCstats'
        encodingStyle='http://schemas.xmlsoap.org/soap/encoding/'/>
    </input>
    <output>
      <soap:body use='encoded' namespace='urn:WSCstats'
        encodingStyle='http://schemas.xmlsoap.org/soap/encoding/'/>
    </output>
  </operation>
  <operation name='getResults'>
    <soap:operation soapAction='urn:WSCstats#getResults'/>
    <input>
      <soap:body use='encoded' namespace='urn:WSCstats'
        encodingStyle='http://schemas.xmlsoap.org/soap/encoding/'/>
    </input>
    <output>
      <soap:body use='encoded' namespace='urn:WSCstats'
        encodingStyle='http://schemas.xmlsoap.org/soap/encoding/'/>
    </output>
  </operation>
</binding> 

<service name='WSCstatsService'>
  <port name='WSCstatsPort' binding='WSCstatsBinding'>
    <soap:address location='http://localhost/Module_F/WSC_Statistics.php'/>
  </port>
</service>
</definitions>
